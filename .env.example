# 数据库
DATABASE_URL=postgres://esp32ide:esp32ide_pass@postgres:5432/esp32ide?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# 存储（本地模式）
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

# 存储（MinIO / 阿里云 OSS 模式，取消注释并填写）
# STORAGE_BACKEND=minio
# STORAGE_MINIO_ENDPOINT=localhost:9000
# STORAGE_MINIO_ACCESS_KEY=minioadmin
# STORAGE_MINIO_SECRET_KEY=minioadmin
# STORAGE_MINIO_BUCKET=esp32-ide
# STORAGE_MINIO_USE_SSL=false

# 编译配置
MAX_CONCURRENT_BUILDS=3
BUILD_TIMEOUT_SECONDS=300
ARDUINO_BUILDER_IMAGE=esp32-ide/arduino-builder:latest
IDF_BUILDER_IMAGE=esp32-ide/idf-builder:latest

# 限流
RATE_LIMIT_BUILD_PER_HOUR=10

# 服务
SERVER_PORT=8080
WORKER_CONCURRENCY=3
